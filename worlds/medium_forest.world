<?xml version='1.0'?>
<sdf version='1.6'>
  <world name='u_shape_lightweight'>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-49 27 52 0 0.75 -0.76 0</pose>
      </camera>
    </gui>

    <shadows>0</shadows>

    <light name='sun' type='directional'>
      <cast_shadows>0</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <physics name='default_physics' default='1' type='ode'>
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <!-- ===================================================== -->
    <!-- Ground: cheap tiled texture, gives LK a feature-rich   -->
    <!-- ground plane at near-zero render cost.                 -->
    <!-- ===================================================== -->

    <model name='ground'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box><size>40 30 0.1</size></box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box><size>40 30 0.1</size></box>
          </geometry>
          <!-- <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/CeilingTiled</name>
            </script>
          </material> -->
        </visual>
      </link>
      <pose>0 0 -0.05 0 0 0</pose>
    </model>

    <!-- ===================================================== -->
    <!-- Striped-pole obstacles, fully inlined (no model://     -->
    <!-- include - that requires an installed model directory  -->
    <!-- and will NOT resolve to a model defined in this same    -->
    <!-- file). Each pole: one cheap cylinder collision +        -->
    <!-- 5 color-banded visual segments for LK-trackable corners.-->
    <!-- ===================================================== -->

    <!-- MEDIUM FOREST OBSTACLES -->

    <model name='pole_01'>
      <static>true</static>
      <pose>-12 5.5 0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.30</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name='b1'>
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>0.6</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.35 0.05 1</ambient>
            <diffuse>0.85 0.35 0.05 1</diffuse>
          </material>
        </visual>

        <visual name='b2'>
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>0.6</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>

        <visual name='b3'>
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>0.6</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.35 0.05 1</ambient>
            <diffuse>0.85 0.35 0.05 1</diffuse>
