<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="medium_forest_0p10_trees_per_m2">

    <!--
      Average-density / medium forest
      Defined test region: x in [-14, 18] m, y in [-13, 12] m
      Area: 32 x 25 = 800 m^2
      Trees: 80
      Density: 80 / 800 = 0.10 trees/m^2
      Nominal average spacing: sqrt(800 / 80) = 3.16 m
      Placement: deterministic jittered 10 x 8 lattice.
    -->

    <physics name="default_physics" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.40 0.40 0.40 1</ambient>
      <background>0.70 0.80 0.90 1</background>
      <shadows>true</shadows>
