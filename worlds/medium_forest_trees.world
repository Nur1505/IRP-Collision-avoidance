<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="medium_forest_striped_poles_0p10_per_m2">

    <!--
      Average-density / medium forest using orange-and-black striped poles.
      Defined test region: x in [-14, 18] m, y in [-13, 12] m
      Area: 32 x 25 = 800 m^2
      Obstacles: 80
      Density: 80 / 800 = 0.10 obstacles/m^2
      Nominal average spacing: sqrt(800 / 80) = 3.16 m
      Pole collision radius: 0.30 m
      Pole height: 3.0 m
      Each pole uses five 0.6 m visual bands, alternating orange and black.
    -->

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-49 27 52 0 0.75 -0.76</pose>
      </camera>
