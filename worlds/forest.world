    <!-- <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/> -->

    <!-- Lighter physics than the original forest world -->
    <physics name='default_physics' default='1' type='ode'>
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <!-- Simple flat ground instead of the huge terrain mesh -->
    <model name='ground'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box>
              <size>40 30 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>40 30 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.45 0.18 1</ambient>
            <diffuse>0.25 0.45 0.18 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.05 0 0 0</pose>
    </model>

    <include>
      <name>normal_tree</name>
      <uri>model://tree_8</uri>
      <pose>-8 5 0 0 0 0</pose>
    </include>
    
