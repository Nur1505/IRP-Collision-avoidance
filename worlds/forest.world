<?xml version='1.0'?>
<sdf version='1.6'>
  <world name='sparse_forest_10_pines'>

  <gui fullscreen='0'>
    <camera name='user_camera'>
      <pose>-80 0 62 0 0.71 0</pose>
    </camera>
  </gui>

    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
      <origin_visual>0</origin_visual>
    </scene>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <!-- Lighter physics than the original forest world -->
    <physics name='default_physics' default='1' type='ode'>
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <!-- Simple flat ground instead of the huge terrain mesh -->
    <model name='ground'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box>
              <size>40 30 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>40 30 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.45 0.18 1</ambient>
            <diffuse>0.25 0.45 0.18 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.05 0 0 0</pose>
    </model>

    <!-- 10 sparse trees using the SAME pine model families from your original world:
         model://pine_1, model://pine_2, ..., model://pine_6
         These are the models referenced in your pasted forest world. -->

    <include>
      <name>tree_01_pine_1</name>
      <uri>model://pine_1</uri>
      <pose>13 3 0 0 0 0</pose>
    </include>

    <include>
      <name>tree_02_pine_2</name>
      <uri>model://pine_2</uri>
      <pose>25 3 0 0 0 0</pose>
    </include>

    <include>
      <name>tree_01_pine_1</name>
      <uri>model://pine_1</uri>
      <pose>18 0 0 0 0 0</pose>
    </include>

    <include>
      <name>tree_02_pine_2</name>
      <uri>model://pine_2</uri>
      <pose>30 0 0 0 0 0</pose>
    </include>

    <include>
      <name>tree_a</name>
      <uri>model://arbol1</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <name>tree_b</name>
      <uri>model://arbol2</uri>
      <pose>-2 5 0 0 0 0</pose>
    </include>

    <include>
      <name>tree_c</name>
      <uri>model://arbol2</uri>
      <pose>-1 -5 0 0 0 0</pose>
    </include>

    <include>
      <name>tree_c</name>
      <uri>model://pine_3</uri>
      <pose>28 8 0 0 0 0</pose>
    </include> 

    <include>
      <name>tree_d</name>
      <uri>model://arbol2</uri>
      <pose>-5 8 0 0 0 0</pose>
    </include>

<!--new new new-->
